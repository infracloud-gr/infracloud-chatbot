# --- LLM Providers ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DEFAULT_CHAT_PROVIDER=groq
CHAT_FALLBACK_ORDER=groq

# --- Embedding ---
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768

# --- Database & Vector Store ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/ragchatbot
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_base
REDIS_URL=redis://redis:6379/0

# --- Rate Limit ---
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_TOKENS_PER_DAY=50000

# --- App ---
SITE_BASE_URL=https://example.com
ENV=production
LOG_LEVEL=INFO
SYNC_DEBOUNCE_SECONDS=2
